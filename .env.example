# Copier en .env puis adapter. Toutes les variables sont optionnelles.

# Source AIS : digitraffic (open data Baltique, sans clé) | aisstream (mondial, clé gratuite)
AIS_SOURCE=digitraffic
# Identifiant envoyé à Digitraffic (en-tête Digitraffic-User demandé par l'API)
DIGITRAFFIC_USER=ipssi-open-data/vigie

# Pour AIS_SOURCE=aisstream : clé à créer sur https://aisstream.io
AISSTREAM_API_KEY=
# Zones surveillées "lat1,lon1,lat2,lon2;..." — ex. Manche + mer du Nord :
# AISSTREAM_BBOXES=48.5,-6,56,9
AISSTREAM_BBOXES=-90,-180,90,180

# Cadence de collecte (secondes)
POLL_INTERVAL_S=60

# Paramètres de détection
CELL_KM=5
# nombre minimal de cargos/pétroliers en attente dans une cellule
CONGESTION_MIN_VESSELS=3
AIS_GAP_MIN=20
ALERT_COOLDOWN_MIN=30
RETENTION_HOURS=48

# IA (LLM open source local via Ollama)
# Modèle : qwen2.5:3b (léger, CPU, bon en français et en appel d'outils)
# Alternatives : llama3.2:3b, mistral:7b, qwen2.5:7b (meilleur mais plus lent)
LLM_MODEL=qwen2.5:3b
# Laisser vide pour désactiver l'IA (le bulletin passe alors en mode gabarit)
# LLM_URL=
LLM_TIMEOUT_S=180
# Fréquence du bulletin et période qu'il couvre (minutes)
BRIEFING_INTERVAL_MIN=15
BRIEFING_WINDOW_MIN=60

# Job Spark Structured Streaming (agrégats par fenêtre de temps)
SPARK_WINDOW=5 minutes
SPARK_WATERMARK=10 minutes
SPARK_TRIGGER=1 minute
SPARK_ZONE_KM=20
SPARK_PORT_RADIUS_NM=5
SPARK_DRIVER_MEMORY=1g
SPARK_RETENTION_HOURS=168
